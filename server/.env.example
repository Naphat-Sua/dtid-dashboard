# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dtid_dashboard

# Server
PORT=3001
NODE_ENV=development

# ── Auth / JWT ──────────────────────────────────────────────
# CHANGE THESE SECRETS before any non-local deployment.
JWT_ACCESS_SECRET=dtid-dev-access-secret-change-me
JWT_REFRESH_SECRET=dtid-dev-refresh-secret-change-me
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=7d

# Optional service-to-service API key (X-Api-Key header)
# SERVICE_API_KEY=

# ── CORS ────────────────────────────────────────────────────
# Comma-separated allowlist, or '*' to reflect any origin (dev only)
CORS_ORIGIN=*

# ── Demo user accounts (created by `npm run db:seed:users`) ─
# admin   / admin1234    (role: Admin   — full CRUD, CSV import, user mgmt)
# analyst / analyst1234  (role: Analyst — spatial + network analysis)
# viewer  / viewer1234   (role: Viewer  — read-only)
# These are DEMONSTRATION credentials only. Change them for real use.
