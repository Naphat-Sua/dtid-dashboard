{
  "name": "dtid-dashboard-server",
  "version": "2.0.0",
  "description": "Backend API server for DTID Dashboard — PostgreSQL/PostGIS",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:create": "psql -U postgres -c 'CREATE DATABASE dtid_dashboard;' || true",
    "db:schema": "psql -U postgres -d dtid_dashboard -f db/schema.sql",
    "db:seed": "psql -U postgres -d dtid_dashboard -f db/seed.sql",
    "db:seed:users": "node db/seedUsers.js",
    "db:reset": "npm run db:create && npm run db:schema && npm run db:seed && npm run db:seed:users"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.0",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0"
  }
}
